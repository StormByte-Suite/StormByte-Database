#pragma once

/**
 * @namespace StormByte
 * @brief Root namespace of the StormByte C++ suite.
 */
namespace StormByte {
	/**
	 * @namespace StormByte::Database
	 * @brief Database module of the StormByte suite.
	 */
	namespace Database {
		/**
		 * @enum Backend
		 * @brief Database backends whose build-time availability can be queried.
		 */
		enum class Backend {
			PostgreSQL,	///< PostgreSQL backend, selected by WITH_POSTGRES.
			MariaDB,	///< MariaDB backend, selected by WITH_MARIADB.
			SQLite,		///< SQLite backend, selected by WITH_SQLITE.
			MSSQL		///< Microsoft SQL Server backend, selected by WITH_MSSQL.
		};

		/**
		 * @brief Report whether a backend was enabled when this library was configured.
		 * @param backend Backend to query.
		 * @return True for SYSTEM or BUNDLED, false for OFF or an unknown backend value.
		 * @note This compile-time query does not check server connectivity or runtime dependencies.
		 */
		constexpr inline bool Available(Backend backend) noexcept {
			switch (backend) {
				case Backend::PostgreSQL: return @STORMBYTE_DATABASE_HAS_POSTGRES@;
				case Backend::MariaDB: return @STORMBYTE_DATABASE_HAS_MARIADB@;
				case Backend::SQLite: return @STORMBYTE_DATABASE_HAS_SQLITE@;
				case Backend::MSSQL: return @STORMBYTE_DATABASE_HAS_MSSQL@;
				default: return false;
			}
		}
	}
}
